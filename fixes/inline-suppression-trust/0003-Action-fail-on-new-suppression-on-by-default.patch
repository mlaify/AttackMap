From ad141ed1c1da8c90301f6a3ef2b08cc3012916cb Mon Sep 17 00:00:00 2001
From: "mlaify-agent (Claude)" <mlaify-agent@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:09:41 +0000
Subject: [PATCH 3/3] Action: fail-on-new-suppression on by default

Defence in depth for GHSA-677m-4884-vg22: with a baseline, a finding that
was active in the baseline and is suppressed in this run fails the job,
whatever silenced it and whatever its severity. The input's description
says what it will also fail (an entry widened on the base, an expiry
extended in the PR, any severity) so that turning it off is an informed
choice; when it is off and a baseline is given, the Action prints a
::warning:: saying a silenced finding will not fail the check.

Co-Authored-By: Claude Mythos 5.1 <noreply@anthropic.com>
---
 action.yml | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/action.yml b/action.yml
index 293780a..f9974bf 100644
--- a/action.yml
+++ b/action.yml
@@ -29,9 +29,16 @@ inputs:
     required: false
     default: "false"
   fail-on-new-suppression:
-    description: "Also fail when a finding that was active in the baseline is suppressed in this run (a suppression's scope or expiry changed). Recommended with suppress-from-ref."
+    description: >-
+      Fail the job when a finding that was active in the baseline is suppressed in this run,
+      i.e. a suppression's scope or expiry grew between the two scans (requires baseline).
+      On by default as defence in depth: on pull requests it catches a silenced finding even
+      when the way it was silenced is not one AttackMap knows about. It fails on any severity,
+      not only HIGH, and it will fail legitimate changes too (an entry widened on the base
+      branch, an expiry extended in the PR) until they are re-trusted on the base. Set to
+      'false' only if you accept that a PR could silence a finding without failing the check.
     required: false
-    default: "false"
+    default: "true"
   output:
     description: "Directory for generated reports. Defaults to $RUNNER_TEMP/attackmap-reports, outside the checkout, so a PR can't plant files or symlinks there."
     required: false
@@ -101,7 +108,13 @@ runs:
               --pr-comment "$out/pr-comment.md")
         [ -n "$ATTACKMAP_BASELINE" ] && args+=(--baseline "$ATTACKMAP_BASELINE")
         [ "$ATTACKMAP_FAIL_ON_NEW_HIGH" = "true" ] && args+=(--fail-on-new-high)
-        [ "$ATTACKMAP_FAIL_ON_NEW_SUPPRESSION" = "true" ] && args+=(--fail-on-new-suppression)
+        if [ -n "$ATTACKMAP_BASELINE" ]; then
+          if [ "$ATTACKMAP_FAIL_ON_NEW_SUPPRESSION" = "true" ]; then
+            args+=(--fail-on-new-suppression)
+          else
+            echo "::warning::fail-on-new-suppression is off: a change that silences a baseline finding (any severity) will not fail this check. Newly suppressed findings are still listed in the PR comment."
+          fi
+        fi
         [ "$ATTACKMAP_CVE" = "true" ] && args+=(--cve)
         # On pull requests, trust only suppressions that already exist on the
         # base branch: a PR must not be able to silence its own findings.
-- 
