{
  "schema_version": "1.0.0",
  "fixture_id": "bluesky-atproto-review-v1",
  "deprecated": true,
  "deprecation_note": "Superseded by bluesky-atproto-review-v2.json — see FINDINGS.md §3 and #44. v1's flat required_keywords/required_terms/required_cautions rejected semantically-equivalent language (DPoP, JWKS, PAR for 'signing'; 'nsid' for 'xrpc'; 'source-quality caveat' for 'low-quality'). v2 fixes this via keyword groups and a pattern-based allowed_id_pattern. Kept on disk so historical eval runs remain reproducible.",
  "target": {
    "repo": "https://github.com/bluesky-social/atproto",
    "ecosystem": "node-service + atproto",
    "notes": "Grounding and defensive-review quality expectations for AT Protocol-style distributed services."
  },
  "review_file": "bluesky-atproto-good-review.md",
  "expectations": {
    "grounding": {
      "citation_pattern": "(?:surface|finding|path):\\d+",
      "allowed_ids": [
        "surface:1",
        "surface:2",
        "surface:3",
        "finding:1",
        "finding:2",
        "path:1"
      ],
      "min_citations": 4
    },
    "observed_inferred": {
      "observed_token": "\\bOBSERVED\\b",
      "inferred_token": "\\bINFERRED\\b",
      "min_observed": 3,
      "min_inferred": 2
    },
    "strengths": {
      "min_items": 2,
      "required_keywords": [
        "signing",
        "service"
      ]
    },
    "weaknesses_hotspots": {
      "min_items": 3,
      "required_terms": [
        "trust boundary",
        "xrpc",
        "hotspot"
      ]
    },
    "recommendations": {
      "min_items": 3,
      "action_verbs": [
        "enforce",
        "validate",
        "constrain"
      ]
    },
    "false_positive_control": {
      "banned_phrases": [
        "definite remote code execution",
        "guaranteed compromise"
      ],
      "required_cautions": [
        "low-quality",
        "heuristic"
      ]
    }
  }
}
